VERSION ""

NS_ : 
	NS_DESC_
	CM_
	BA_DEF_
	BA_
	VAL_
	CAT_DEF_
	CAT_
	FILTER
	BA_DEF_DEF_
	EV_DATA_
	ENVVAR_DATA_
	SGTYPE_
	SGTYPE_VAL_
	BA_DEF_SGTYPE_
	BA_SGTYPE_
	SIG_TYPE_REF_
	VAL_TABLE_
	SIG_GROUP_
	SIG_VALTYPE_
	SIGTYPE_VALTYPE_
	BO_TX_BU_
	BA_DEF_REL_
	BA_REL_
	BA_DEF_DEF_REL_
	BU_SG_REL_
	BU_EV_REL_
	BU_BO_REL_
	SG_MUL_VAL_

BS_:

BU_: BMS VCU GW

BO_ 256 BMS_Status: 8 BMS
 SG_ BatteryVoltage : 0|16@1+ (0.1,0) [0|6553.5] "V" VCU,GW
 SG_ BatteryCurrent : 16|16@1- (0.1,0) [-3276.8|3276.7] "A" VCU,GW
 SG_ BatterySoC : 32|8@1+ (0.5,0) [0|100] "%" VCU,GW
 SG_ BatteryTempMax : 40|8@1+ (1,-40) [-40|215] "degC" VCU,GW
 SG_ BMS_Heartbeat : 48|8@1+ (1,0) [0|255] "" VCU,GW
 SG_ BMS_RelayState : 56|2@1+ (1,0) [0|3] "" VCU,GW

BO_ 512 VCU_DriveControl: 8 VCU
 SG_ TargetTorque : 0|16@1+ (0.5,0) [0|32767.5] "Nm" BMS,GW
 SG_ VehicleSpeed : 16|16@1+ (0.1,0) [0|6553.5] "km/h" BMS,GW
 SG_ AcceleratorPedal : 32|8@1+ (0.4,0) [0|100] "%" BMS,GW
 SG_ BrakePedalState : 40|2@1+ (1,0) [0|3] "" BMS,GW
 SG_ GearPosition : 42|3@1+ (1,0) [0|7] "" BMS,GW
 SG_ VCU_AliveCounter : 48|4@1+ (1,0) [0|15] "" BMS,GW
 SG_ VCU_Checksum : 56|8@1+ (1,0) [0|255] "" BMS,GW

CM_ BU_ BMS "Battery Management System ECU";
CM_ BU_ VCU "Vehicle Control Unit ECU";
CM_ BU_ GW "Central Gateway ECU";
CM_ BO_ 256 "BMS telemetry frame sent periodically every 50ms (ID 0x100)";
CM_ BO_ 512 "VCU powertrain control frame sent periodically every 20ms (ID 0x200)";
CM_ SG_ 256 BatteryCurrent "Negative: Discharge current, Positive: Charge current";
CM_ SG_ 512 TargetTorque "Demand torque sent to traction inverter";

BA_DEF_ BO_ "GenMsgCycleTime" INT 0 10000;
BA_DEF_ BO_ "GenMsgSendType" ENUM "Cyclic","Event","Mixed";
BA_DEF_ SG_ "GenSigStartValue" INT 0 65535;

BA_DEF_DEF_ "GenMsgCycleTime" 100;
BA_DEF_DEF_ "GenMsgSendType" "Cyclic";
BA_DEF_DEF_ "GenSigStartValue" 0;

BA_ "GenMsgCycleTime" BO_ 256 50;
BA_ "GenMsgSendType" BO_ 256 "Cyclic";
BA_ "GenMsgCycleTime" BO_ 512 20;
BA_ "GenMsgSendType" BO_ 512 "Cyclic";
