diff --git a/src_before/as/release/ascore/app/app.c b/src_after/as/release/ascore/app/app.c
index b957cb1..effd77f 100644
--- a/src_before/as/release/ascore/app/app.c
+++ b/src_after/as/release/ascore/app/app.c
@@ -166,12 +166,36 @@ void* lv_task_thread(void* args)
 #endif
 #endif
 
+#include "Com.h"
+#include "Com_PbCfg.h"
+
 void __weak TaskAppHook(void) { }
 TASK(TaskApp)
 {
 	OS_TASK_BEGIN();
 	ASLOG(OFF,("TaskApp is running\n"));
 
+	static uint16_t simSpeed = 40;
+	static uint8_t simSoc = 80;
+	static uint32_t tickCount = 0;
+	tickCount++;
+	if (tickCount % 20 == 0) {
+		simSpeed = (simSpeed >= 120) ? 40 : (simSpeed + 2);
+		simSoc = (simSoc <= 20) ? 80 : (simSoc - 1);
+		
+		Com_SendSignal(COM_SID_VehicleSpeed, &simSpeed);
+
+		/* Broadcast Frame 1: BMS State (ID 0x180) */
+		uint8_t bms_data[8] = {simSoc, 100, 0x10, 0x0E, 0x96, 0x00, 65, 0x00};
+		Can_PduType bms_pdu = { .id = 0x180, .length = 8, .sdu = bms_data, .swPduHandle = 0 };
+		Can_Write(0, &bms_pdu);
+
+		/* Broadcast Frame 2: VCU Torque Command (ID 0x200) */
+		uint8_t vcu_data[8] = {0x03, (uint8_t)(simSpeed & 0xFF), (uint8_t)((simSpeed >> 8) & 0xFF), 120, 0x00, 0x00, 80, 0x01};
+		Can_PduType vcu_pdu = { .id = 0x200, .length = 8, .sdu = vcu_data, .swPduHandle = 1 };
+		Can_Write(0, &vcu_pdu);
+	}
+
 	TaskAppHook();
 #ifdef USE_SG
 	ASPERF_MEASURE_START();
